# LOCAL DEVELOPMENT ONLY — DO NOT USE THESE VALUES IN PRODUCTION.
#
# Development-only credentials for the services in docker-compose.yml. The
# values below are identical to the defaults in docker-compose.yml, so Compose
# also works without a root `.env` file. To customize them, copy this file to
# `.env` (ignored by Git) and edit the copy:
#
#   cp .env.example .env
#
# If you change a value, update the matching backend variables too (see
# backend/.env.example and docs/local-development.md).

# PostgreSQL
POSTGRES_USER=clipforge
POSTGRES_PASSWORD=clipforge_dev_password
POSTGRES_DB=clipforge

# MinIO (S3-compatible storage). The password must be at least 8 characters.
MINIO_ROOT_USER=clipforge_dev
MINIO_ROOT_PASSWORD=clipforge_dev_password
