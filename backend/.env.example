# LOCAL DEVELOPMENT ONLY — DO NOT USE THESE VALUES IN PRODUCTION.
#
# Template for backend/.env. Copy it to backend/.env (which is git-ignored)
# and adjust the values; the backend loads backend/.env automatically.
# Variables set in the process environment take precedence over the file.
# The service credentials match the development-only defaults in the root
# docker-compose.yml and root .env.example. See backend/README.md and
# docs/local-development.md.

# Environment: development | test | production
APP_ENV=development

# Application name (used as the API title)
APP_NAME=ClipForge AI

# PostgreSQL (compose service `postgres`): POSTGRES_USER, POSTGRES_PASSWORD,
# and POSTGRES_DB from the root .env.example.
DATABASE_URL=postgresql://clipforge:clipforge_dev_password@localhost:5433/clipforge

# Redis (compose service `redis`): Celery broker and result backend for
# background jobs. Without it the API still runs, but queuing a job fails it
# with "could not be queued". Not used when APP_ENV=test (tasks run eagerly).
REDIS_URL=redis://localhost:6379/0

# Secret used to sign tokens. This placeholder is rejected when
# APP_ENV=production; generate a real value, for example with
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=<generate-a-long-random-secret>

# ACCESS_TOKEN_EXPIRE_MINUTES: access token lifetime in minutes, a positive
# integer. Not assigned here so the built-in default of 30 applies; add the
# variable to backend/.env (or the environment) with a number to override it.

# EMAIL_VERIFICATION_TOKEN_EXPIRE_MINUTES and PASSWORD_RESET_TOKEN_EXPIRE_MINUTES:
# lifetimes in minutes of the single-use email verification and password
# reset tokens, positive integers. Not assigned here so the built-in defaults
# (1440 and 30) apply; add them to backend/.env to override.

# Outgoing email (email verification and password reset links).
# "fake" records messages in memory and sends nothing; it needs no account
# and is refused when APP_ENV=production. "smtp" delivers through an SMTP
# server; see docs/setup/email.md. For a local inbox, run Mailpit and use
# SMTP_HOST=localhost, SMTP_PORT=1025, SMTP_SECURITY=none.
EMAIL_PROVIDER=fake
# Base URL of the web app; emailed links point at <FRONTEND_URL>/verify-email
# and <FRONTEND_URL>/reset-password.
FRONTEND_URL=http://localhost:3000
# Needed only when EMAIL_PROVIDER=smtp (uncomment and fill in backend/.env):
# EMAIL_FROM=<your-sender-address>
# SMTP_HOST=<your-smtp-host>
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# SMTP_USERNAME=<your-smtp-username>
# SMTP_PASSWORD=<your-smtp-password>
# SMTP_TIMEOUT_SECONDS=10

# Speech-to-text provider. "fake" returns deterministic placeholder segments,
# needs no account and makes no network calls; it is refused when
# APP_ENV=production. No real provider is available yet.
TRANSCRIPTION_PROVIDER=fake

# Comma-separated list of allowed CORS origins ("*" is always ignored)
CORS_ORIGINS=http://localhost:3000

# Maximum upload size in megabytes (MiB)
MAX_UPLOAD_SIZE_MB=500

# Comma-separated upload allowlists. Only .mp4, .mov, .webm and .mkv (and
# their content types) have a known file signature; other entries are ignored.
ALLOWED_VIDEO_EXTENSIONS=.mp4,.mov,.webm,.mkv
ALLOWED_VIDEO_CONTENT_TYPES=video/mp4,video/quicktime,video/webm,video/x-matroska

# Storage backend: local | s3
STORAGE_BACKEND=local

# LOCAL_STORAGE_DIR: root directory of the local storage backend. Not assigned
# here so the built-in default backend/storage (git-ignored) applies; a
# relative value is resolved against the current working directory. Add the
# variable to backend/.env to store files elsewhere.

# S3-compatible storage, used when STORAGE_BACKEND=s3. These values point at
# the local MinIO (compose service `minio`): the access key and secret key are
# MINIO_ROOT_USER and MINIO_ROOT_PASSWORD. Create the bucket in the MinIO
# console (http://localhost:9001) first. MinIO needs path-style addressing.
# For Cloudflare R2 or AWS S3 see backend/README.md and docs/setup/s3-storage.md.
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=clipforge_dev
S3_SECRET_ACCESS_KEY=clipforge_dev_password
S3_REGION=us-east-1
S3_BUCKET=clipforge
S3_ADDRESSING_STYLE=path
