# LOCAL DEVELOPMENT ONLY — DO NOT USE THESE VALUES IN PRODUCTION.
#
# Backend environment for the services in the root docker-compose.yml. The
# credentials match the development-only defaults in docker-compose.yml and
# the root .env.example. The backend reads these from the process environment;
# it does not load this file automatically. See docs/local-development.md.

# PostgreSQL (compose service `postgres`): POSTGRES_USER, POSTGRES_PASSWORD,
# and POSTGRES_DB from the root .env.example.
DATABASE_URL=postgresql://clipforge:clipforge_dev_password@localhost:5433/clipforge

# Redis (compose service `redis`)
REDIS_URL=redis://localhost:6379/0

# MinIO S3-compatible storage (compose service `minio`): the access key and
# secret key are MINIO_ROOT_USER and MINIO_ROOT_PASSWORD.
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=clipforge_dev
S3_SECRET_ACCESS_KEY=clipforge_dev_password
S3_REGION=us-east-1

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000
