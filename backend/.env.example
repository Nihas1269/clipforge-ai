# LOCAL DEVELOPMENT ONLY — DO NOT USE THESE VALUES IN PRODUCTION.
#
# Template for backend/.env. Copy it to backend/.env (which is git-ignored)
# and adjust the values; the backend loads backend/.env automatically.
# Variables set in the process environment take precedence over the file.
# The service credentials match the development-only defaults in the root
# docker-compose.yml and root .env.example. See backend/README.md and
# docs/local-development.md.

# Environment: development | test | production
APP_ENV=development

# Application name (used as the API title)
APP_NAME=ClipForge AI

# PostgreSQL (compose service `postgres`): POSTGRES_USER, POSTGRES_PASSWORD,
# and POSTGRES_DB from the root .env.example.
DATABASE_URL=postgresql://clipforge:clipforge_dev_password@localhost:5433/clipforge

# Redis (compose service `redis`): Celery broker and result backend for
# background jobs. Without it the API still runs, but queuing a job fails it
# with "could not be queued". Not used when APP_ENV=test (tasks run eagerly).
REDIS_URL=redis://localhost:6379/0

# Secret used to sign tokens. This placeholder is rejected when
# APP_ENV=production; generate a real value, for example with
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=<generate-a-long-random-secret>

# ACCESS_TOKEN_EXPIRE_MINUTES: access token lifetime in minutes, a positive
# integer. Not assigned here so the built-in default of 30 applies; add the
# variable to backend/.env (or the environment) with a number to override it.

# EMAIL_VERIFICATION_TOKEN_EXPIRE_MINUTES and PASSWORD_RESET_TOKEN_EXPIRE_MINUTES:
# lifetimes in minutes of the single-use email verification and password
# reset tokens, positive integers. Not assigned here so the built-in defaults
# (1440 and 30) apply; add them to backend/.env to override.

# Outgoing email (email verification and password reset links).
# "fake" records messages in memory and sends nothing; it needs no account
# and is refused when APP_ENV=production. "smtp" delivers through an SMTP
# server; see docs/setup/email.md. For a local inbox, run Mailpit and use
# SMTP_HOST=localhost, SMTP_PORT=1025, SMTP_SECURITY=none.
EMAIL_PROVIDER=fake
# Base URL of the web app; emailed links point at <FRONTEND_URL>/verify-email
# and <FRONTEND_URL>/reset-password.
FRONTEND_URL=http://localhost:3000
# Needed only when EMAIL_PROVIDER=smtp (uncomment and fill in backend/.env):
# EMAIL_FROM=<your-sender-address>
# SMTP_HOST=<your-smtp-host>
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# SMTP_USERNAME=<your-smtp-username>
# SMTP_PASSWORD=<your-smtp-password>
# SMTP_TIMEOUT_SECONDS=10

# Speech-to-text provider: fake | openai_compatible | local_whisper.
# "fake" returns deterministic placeholder segments, needs no account and
# makes no network calls; it is refused when APP_ENV=production. See
# backend/README.md (Transcripts) and docs/setup/transcription.md.
TRANSCRIPTION_PROVIDER=fake
# Needed only for the real providers (uncomment and fill in backend/.env).
# openai_compatible: the API base URL (https://, or http:// only for
# localhost), the API key (optional for localhost) and the model name.
# local_whisper: only TRANSCRIPTION_MODEL (a model size such as small, or a
# model directory), after pip install -r requirements-ml.txt.
# TRANSCRIPTION_API_BASE_URL=<your-transcription-api-base-url>
# TRANSCRIPTION_API_KEY=<your-transcription-api-key>
# TRANSCRIPTION_MODEL=<your-transcription-model>
# TRANSCRIPTION_TIMEOUT_SECONDS (default 300, at most 1800),
# TRANSCRIPTION_MAX_UPLOAD_MB (default 24; larger audio is split into chunks)
# and TRANSCRIPTION_CHUNK_SECONDS (default 600, 30 to 3600) apply to
# openai_compatible. Not assigned here so the defaults apply.

# Comma-separated list of allowed CORS origins ("*" is always ignored)
CORS_ORIGINS=http://localhost:3000

# Maximum upload size in megabytes (MiB)
MAX_UPLOAD_SIZE_MB=500

# Comma-separated upload allowlists. Only .mp4, .mov, .webm and .mkv (and
# their content types) have a known file signature; other entries are ignored.
ALLOWED_VIDEO_EXTENSIONS=.mp4,.mov,.webm,.mkv
ALLOWED_VIDEO_CONTENT_TYPES=video/mp4,video/quicktime,video/webm,video/x-matroska

# Longest accepted video in seconds; longer uploads are marked failed by the
# metadata extraction job.
MAX_VIDEO_DURATION_SECONDS=7200

# Clip detection: shortest and longest suggested clip in seconds (at most
# 600; the minimum must not exceed the maximum) and the most clips suggested
# per video (1-50).
CLIP_MIN_SECONDS=15
CLIP_MAX_SECONDS=90
CLIP_MAX_CLIPS=10
# CLIP_KEYWORDS: comma-separated words or phrases the heuristic detector
# rewards (case-insensitive, whole words). Not assigned here so the built-in
# list in app/core/config.py applies; for example
# CLIP_KEYWORDS=secret,mistake,how to,lesson

# Clip detector: heuristic | llm. "heuristic" works offline and needs no
# account. "llm" asks an LLM for clips and falls back to the heuristic
# detector (with a warning) when the LLM settings below are missing or a
# request fails. See docs/setup/llm.md.
CLIP_DETECTOR=heuristic
# Needed only for CLIP_DETECTOR=llm (uncomment and fill in backend/.env).
# LLM_PROVIDER: openai_compatible (chat completions) or anthropic (Messages
# API). LLM_API_BASE_URL includes the version path and must be https://
# (http:// only for localhost); the key may be left unset for localhost.
# LLM_PROVIDER=<openai_compatible-or-anthropic>
# LLM_API_BASE_URL=<your-llm-api-base-url>
# LLM_API_KEY=<your-llm-api-key>
# LLM_MODEL=<your-llm-model>
# LLM_TIMEOUT_SECONDS (default 60, at most 600), LLM_MAX_PROMPT_CHARS (default
# 24000; longer transcripts are split into several requests),
# LLM_MAX_OUTPUT_TOKENS (default 2048) and the optional prices
# LLM_INPUT_COST_PER_MILLION_TOKENS / LLM_OUTPUT_COST_PER_MILLION_TOKENS (USD,
# used only to log an estimated cost) are not assigned here so the defaults
# apply.

# Billing plans (backend/README.md, Billing). Prices are in paise and every
# value is a placeholder, not an approved commercial term. Not assigned here
# so the built-in defaults apply: free 60 upload minutes, 10 exports, 1800 s
# videos, 250 MB uploads per month; pro 99900 paise, 0 included credits, 600
# upload minutes, 200 exports, 7200 s videos, 500 MB uploads. The pro limits
# must not be lower than the free limits. For example:
# BILLING_FREE_MONTHLY_UPLOAD_MINUTES=60
# BILLING_FREE_MONTHLY_EXPORTS=10
# BILLING_FREE_MAX_VIDEO_DURATION_SECONDS=1800
# BILLING_FREE_MAX_UPLOAD_SIZE_MB=250
# BILLING_PRO_PRICE_MINOR=99900
# BILLING_PRO_INCLUDED_CREDITS=0
# BILLING_PRO_MONTHLY_UPLOAD_MINUTES=600
# BILLING_PRO_MONTHLY_EXPORTS=200
# BILLING_PRO_MAX_VIDEO_DURATION_SECONDS=7200
# BILLING_PRO_MAX_UPLOAD_SIZE_MB=500
# Razorpay plan id of the pro plan (not a secret; not used until checkout is
# implemented):
# RAZORPAY_PRO_PLAN_ID=<your-razorpay-pro-plan-id>

# FFmpeg / ffprobe used by the background worker: a command name found on
# PATH or a full path to the binary (for example C:\ffmpeg\bin\ffmpeg.exe).
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# FFMPEG_TIMEOUT_SECONDS (default 1800, at most 3600) and
# FFPROBE_TIMEOUT_SECONDS (default 60, at most 600): a process running longer
# is killed. FFMPEG_MAX_MEMORY_MB (default 8192, virtual address space) and
# FFMPEG_MAX_OUTPUT_FILE_MB (default 2048) limit FFmpeg processes on Linux and
# macOS. Not assigned here so the defaults apply.

# Storage backend: local | s3
STORAGE_BACKEND=local

# LOCAL_STORAGE_DIR: root directory of the local storage backend. Not assigned
# here so the built-in default backend/storage (git-ignored) applies; a
# relative value is resolved against the current working directory. Add the
# variable to backend/.env to store files elsewhere.

# S3-compatible storage, used when STORAGE_BACKEND=s3. These values point at
# the local MinIO (compose service `minio`): the access key and secret key are
# MINIO_ROOT_USER and MINIO_ROOT_PASSWORD. Create the bucket in the MinIO
# console (http://localhost:9001) first. MinIO needs path-style addressing.
# For Cloudflare R2 or AWS S3 see backend/README.md and docs/setup/s3-storage.md.
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=clipforge_dev
S3_SECRET_ACCESS_KEY=clipforge_dev_password
S3_REGION=us-east-1
S3_BUCKET=clipforge
S3_ADDRESSING_STYLE=path
