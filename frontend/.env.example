# Copy this file to .env.local and adjust values for local development.
# NEXT_PUBLIC_* values are embedded in the browser bundle: never put secrets here.

# Base URL of the backend API. Use the same host name as the frontend
# (localhost, not 127.0.0.1): the session cookie is SameSite=Lax, so browsers
# only send it when the frontend and API are on the same site. The frontend
# origin (http://localhost:3000) must be listed in the backend's CORS_ORIGINS.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Fallback maximum upload size in MiB, a positive whole number. The upload page
# reads the real limits from the backend (GET /api/v1/videos/upload-limits) and
# uses this value only if that request fails. Keep it equal to the backend's
# MAX_UPLOAD_SIZE_MB; the backend always enforces its own limit.
NEXT_PUBLIC_MAX_UPLOAD_SIZE_MB=500
